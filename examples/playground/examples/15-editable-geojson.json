{
  "name": "Editable GeoJSON",
  "description": "Select features, switch editing modes, and draw or transform geometry.",
  "metadata": {"screencap": "https://raw.githubusercontent.com/visgl/deck.gl-community/master/website/static/images/examples/editable-layers/advanced.png"},
  "initialViewState": {"longitude": -122.43, "latitude": 37.775, "zoom": 12},
