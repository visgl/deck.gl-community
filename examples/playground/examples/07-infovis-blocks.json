    {"@@type": "FastTextLayer", "id": "labels", "data": [{"position": [-185, 30], "label": "parse"}, {"position": [15, 30], "label": "layout"}, {"position": [215, 30], "label": "draw"}], "coordinateSystem": 2, "getPosition": "@@=position", "getText": "@@=label", "size": 17, "getColor": [255, 255, 255, 255], "textAnchor": "middle", "alignmentBaseline": "center"}
  ]
