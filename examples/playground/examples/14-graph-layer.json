{
  "metadata": {"title": "Graph layout", "description": "A small knowledge graph positioned by SimpleLayout.", "screencap": "https://raw.githubusercontent.com/visgl/deck.gl-community/master/website/static/images/examples/graph-layers/simple-graph.png"},
  "views": {"@@type": "OrthographicView", "id": "graph", "flipY": false},
  "initialViewState": {"target": [0, 0, 0], "zoom": 0},
  "layers": [
    {"@@type": "GraphLayer", "id": "knowledge-graph", "data": {"nodes": [{"id": "deck", "label": "deck.gl", "attributes": {"x": 0, "y": 120}}, {"id": "layers", "label": "Layers", "attributes": {"x": -180, "y": -40}}, {"id": "views", "label": "Views", "attributes": {"x": 0, "y": -40}}, {"id": "data", "label": "Data", "attributes": {"x": 180, "y": -40}}], "edges": [{"id": "e1", "sourceId": "deck", "targetId": "layers"}, {"id": "e2", "sourceId": "deck", "targetId": "views"}, {"id": "e3", "sourceId": "deck", "targetId": "data"}]}, "layout": "@@#SimpleLayout", "enableDragging": true, "stylesheet": {"nodes": [{"type": "circle", "radius": 18, "fill": "#3b82f6", "stroke": "#1e3a8a", "strokeWidth": 2}, {"type": "label", "text": "@label", "color": "#0f172a", "fontSize": 14, "offset": [0, 24], "textAnchor": "middle", "alignmentBaseline": "top"}], "edges": {"stroke": "#64748b", "strokeWidth": 2}}}
  ]
}
