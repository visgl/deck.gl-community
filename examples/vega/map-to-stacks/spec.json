{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "Synthetic city records move between a schematic contiguous-US map and region bars stacked by sector. Inspired by Microsoft Research SandDance; no population or economic measurements.",
  "width": 700,
  "height": 380,
  "padding": 15,
  "background": "#f0f6fc",
  "signals": [
    {
      "name": "layout",
      "value": "map",
      "bind": {
        "input": "select",
        "options": [
          "map",
          "stacks"
        ],
        "labels": [
          "US map",
          "Stacked bars"
        ],
        "name": "Layout"
      }
    },
    {
      "name": "width",
      "init": "min(700, max(300, containerSize()[0] - 30))",
      "on": [
        {
          "events": {
            "source": "container",
            "type": "resize"
          },
          "update": "min(700, max(300, containerSize()[0] - 30))"
        }
      ]
    },
    {
      "name": "unit",
      "update": "width / 700"
    }
  ],
  "projections": [
    {
      "name": "map",
      "type": "albers",
      "rotate": [
        96,
        0,
        0
      ],
      "center": [
        -0.6,
        38.7
      ],
      "parallels": [
        29.5,
        45.5
      ],
      "scale": {
        "signal": "850 * unit"
      },
      "translate": {
        "signal": "[width / 2, 180]"
      },
      "clipExtent": {
        "signal": "[[0,0],[width,height]]"
      }
    }
  ],
  "data": [
    {
      "name": "outline",
      "values": [
        {
          "type": "Feature",
          "geometry": {
            "type": "LineString",
            "coordinates": [
              [
