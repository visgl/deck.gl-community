    },
    {
      "name": "records",
      "transform": [
        {
          "type": "sequence",
          "start": 0,
          "stop": 198,
          "as": "id"
        },
        {
          "type": "formula",
          "expr": "floor(datum.id / 9)",
          "as": "cityId"
        },
        {
          "type": "lookup",
          "from": "cities",
          "key": "cityId",
          "fields": [
            "cityId"
          ],
          "values": [
            "city",
            "lon",
            "lat",
            "region"
          ]
        },
        {
          "type": "formula",
          "expr": "['Services','Manufacturing','Technology'][floor((datum.id % 9) / 3)]",
          "as": "sector"
        },
        {
          "type": "geopoint",
          "projection": "map",
          "fields": [
            "lon",
            "lat"
          ],
          "as": [
            "mapX",
            "mapY"
          ]
        },
        {
          "type": "window",
          "groupby": [
            "region"
          ],
          "sort": {
            "field": [
              "sector",
              "id"
            ],
            "order": [
              "ascending",
              "ascending"
            ]
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        }
      ]
    },
    {
      "name": "regions",
      "source": "records",
      "transform": [
        {
          "type": "aggregate",
          "groupby": [
            "region"
          ],
          "ops": [
            "count"
          ],
          "as": [
            "count"
          ]
        }
      ]
    },
    {
      "name": "sectors",
      "values": [
        {
          "sector": "Services",
          "index": 0
        },
        {
          "sector": "Manufacturing",
          "index": 1
        },
        {
          "sector": "Technology",
          "index": 2
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "region",
      "type": "band",
      "domain": [
        "West",
        "Midwest",
        "South",
        "Northeast"
      ],
      "range": {
        "signal": "[45 * unit, width - 45 * unit]"
      },
      "padding": 0.35
    },
    {
      "name": "color",
      "type": "ordinal",
      "domain": [
        "Services",
        "Manufacturing",
        "Technology"
      ],
      "range": [
        "#3688c8",
        "#e69f00",
        "#009e73"
      ]
    }
  ],
  "marks": [
    {
      "type": "shape",
      "from": {
        "data": "outline"
      },
      "transform": [
        {
          "type": "geoshape",
          "projection": "map"
        }
      ],
      "encode": {
        "update": {
          "fill": {
            "value": null
          },
          "stroke": {
            "value": "#7892a5"
          },
          "strokeWidth": {
            "value": 1
          },
          "opacity": {
            "signal": "layout === 'map' ? 1 : 0"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "records"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "layout === 'map' ? datum.mapX + ((datum.id % 9) % 3 - 1) * 7 * unit - 3 * unit : scale('region', datum.region) + ((datum.rank - 1) % 9) * 9 * unit"
          },
          "y": {
            "signal": "layout === 'map' ? datum.mapY + (floor((datum.id % 9) / 3) - 1) * 7 * unit - 3 * unit : 305 - ceil(datum.rank / 9) * 24"
          },
          "width": {
            "signal": "(layout === 'map' ? 6 : 8) * unit"
          },
          "height": {
            "signal": "layout === 'map' ? 6 * unit : 23"
          },
          "fill": {
            "scale": "color",
            "field": "sector"
          },
          "tooltip": {
            "signal": "{Record: datum.id, City: datum.city, Region: datum.region, Sector: datum.sector}"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "regions"
      },
      "encode": {
        "update": {
          "x": {
            "scale": "region",
            "field": "region",
            "band": 0.5
          },
          "y": {
            "value": 325
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "signal": "13 * unit"
          },
          "fill": {
            "value": "#7892a5"
          },
          "text": {
            "signal": "layout === 'stacks' ? datum.region + ' (' + datum.count + ')' : ''"
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "value": 375
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "signal": "12 * unit"
          },
          "fill": {
            "value": "#7892a5"
          },
          "text": {
            "signal": "layout === 'map' ? '198 synthetic records at 22 city centers \u00b7 schematic contiguous US' : 'One tile = one record \u00b7 bars grouped by region and stacked by sector'"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "sectors"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.index + 1) * width / 4"
          },
          "y": {
            "value": 350
          },
          "align": {
            "value": "center"
          },
          "fontSize": {
            "signal": "13 * unit"
          },
          "fill": {
            "scale": "color",
            "field": "sector"
          },
          "text": {
            "field": "sector"
          }
        }
      }
    }
  ]
}
