{
  "name": "@deck.gl-community/panels",
  "version": "10.0.0-alpha.1",
  "description": "Deck-independent panel composition and standalone UI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "panels",
    "widgets",
    "ui",
    "visualization"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "prepack": "yarn --cwd ../.. build",
    "test": "vitest run",
    "test-watch": "vitest"
  },
  "dependencies": {
    "monaco-editor": "^0.53.0",
    "preact": "^10.17.0",
    "probe.gl": "^5.0.0"
  },
  "peerDependencies": {
    "apache-arrow": ">=17"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  }
}
