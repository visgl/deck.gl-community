{
  "name": "@deck.gl-community/layers",
  "version": "9.4.2",
  "description": "Add-on layers for deck.gl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "layers",
    "visualization",
    "gpu",
    "deck.gl"
  ],
  "type": "module",
  "sideEffects": [
    "./src/splat-layer/scene/*-worker.*",
    "./dist/splat-layer/scene/*-worker.js"
  ],
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./workers/rad": "./dist/splat-layer/scene/rad-source-worker.js",
    "./workers/static": "./dist/splat-layer/scene/static-source-worker.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test-watch": "vitest",
    "build": "node ../../scripts/build-splat-worker.mjs"
  },
  "dependencies": {
    "@loaders.gl/loader-utils": "^4.5.3",
    "@loaders.gl/splats": "^4.5.3",
    "@loaders.gl/textures": "^4.5.1",
    "@luma.gl/constants": "~9.4.0",
    "@luma.gl/shadertools": "~9.4.0",
    "@luma.gl/splats": "~9.4.2",
    "@math.gl/core": "^4.0.0"
  },
  "peerDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@loaders.gl/core": "^4.5.1",
    "@luma.gl/core": "~9.4.0",
    "@luma.gl/engine": "~9.4.0"
  },
  "devDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mesh-layers": "~9.4.0",
    "@deck.gl/test-utils": "~9.4.0",
    "@loaders.gl/core": "^4.5.1",
    "@luma.gl/core": "~9.4.0",
    "@luma.gl/engine": "~9.4.0",
    "@luma.gl/webgpu": "~9.4.0",
    "@probe.gl/test-utils": "^4.1.1"
  }
}
