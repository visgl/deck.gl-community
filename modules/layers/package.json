    "@luma.gl/core": "10.0.0-beta.3",
    "@luma.gl/engine": "10.0.0-beta.3",
    "@luma.gl/graph": "10.0.0-beta.3",
    "@math.gl/earth": "5.0.2",
    "a5-js": "^0.5.0",
