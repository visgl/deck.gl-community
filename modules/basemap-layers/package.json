{
  "name": "@deck.gl-community/basemap-layers",
  "version": "9.4.4",
  "description": "Basemap layer and map-style helpers for deck.gl.",
  "license": "MIT",
  "keywords": [
    "deck.gl",
    "mapbox",
    "basemap"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./map-style": {
      "types": "./dist/map-style.d.ts",
      "require": "./dist/map-style.cjs",
      "import": "./dist/map-style.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "yarn --cwd ../.. vitest run --config modules/basemap-layers/vitest.config.ts",
    "test-watch": "yarn --cwd ../.. vitest --config modules/basemap-layers/vitest.config.ts"
  },
  "devDependencies": {
    "@deck.gl-community/geo-layers": "workspace:*",
    "@deck.gl/test-utils": "~9.4.0",
    "@fontsource/montserrat": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/open-sans": "5.3.0",
    "@loaders.gl/core": "^4.5.1",
    "maplibre-gl": "6.13.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@loaders.gl/loader-utils": "^4.5.1",
    "@loaders.gl/mvt": "^4.5.1",
    "@mapbox/tiny-sdf": "^2.0.5",
    "@maplibre/geojson-vt": "^6.1.2",
    "@maplibre/maplibre-gl-style-spec": "^24.8.1",
    "@turf/polygon-to-line": "^6.0.3",
    "bidi-js": "^1.1.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@deck.gl-community/geo-layers": "~9.4.2",
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/extensions": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@loaders.gl/core": "^4.5.1",
    "@luma.gl/core": "~9.4.0",
    "@luma.gl/engine": "~9.4.0"
  }
}
