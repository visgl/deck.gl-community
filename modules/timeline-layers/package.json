{
  "name": "@deck.gl-community/timeline-layers",
  "version": "9.4.10",
  "description": "Layers for compact timeline visualizations in deck.gl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "layers",
    "visualization",
    "gpu",
    "deck.gl"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
