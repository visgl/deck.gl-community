{
  "name": "@deck.gl-community/infovis-layers",
  "version": "9.4.0",
  "description": "Infovis layers (non-geospatial) for deck.gl",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "layers",
    "visualization",
    "gpu",
    "deck.gl"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test-watch": "vitest"
  },
  "dependencies": {
    "@luma.gl/shadertools": "~9.4.0",
    "@probe.gl/log": "^4.1.1"
  },
  "peerDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@luma.gl/core": "~9.4.0",
    "@luma.gl/engine": "~9.4.0",
    "apache-arrow": ">=17"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/test-utils": "~9.4.0",
    "@luma.gl/core": "~9.4.0",
    "@luma.gl/engine": "~9.4.0",
    "@luma.gl/webgpu": "~9.4.0",
    "@probe.gl/test-utils": "^4.1.1"
  }
}
