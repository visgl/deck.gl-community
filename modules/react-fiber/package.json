{
  "name": "@deck.gl-community/react-fiber",
  "version": "9.4.10",
  "private": true,
  "description": "A React Fiber renderer for deck.gl",
  "license": "MIT",
  "author": "Brandon Pierce (https://github.com/brandonjpierce)",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "deck.gl",
    "deckgl",
    "fiber",
    "react",
    "renderer"
  ],
  "type": "module",
  "sideEffects": [
    "dist/types/jsx.*"
  ],
  "types": "./dist/dom/index.d.ts",
  "main": "./dist/dom/index.cjs",
  "module": "./dist/dom/index.js",
  "exports": {
    ".": {
      "types": "./dist/dom/index.d.ts",
      "require": "./dist/dom/index.cjs",
      "import": "./dist/dom/index.js"
    },
    "./mapbox": {
      "types": "./dist/dom/mapbox.d.ts",
      "require": "./dist/dom/mapbox.cjs",
      "import": "./dist/dom/mapbox.js"
    },
    "./maplibre": {
      "types": "./dist/dom/maplibre.d.ts",
      "require": "./dist/dom/maplibre.cjs",
      "import": "./dist/dom/maplibre.js"
    },
    "./core": {
      "types": "./dist/wrappers/core.d.ts",
      "require": "./dist/wrappers/core.cjs",
      "import": "./dist/wrappers/core.js"
    },
    "./layers": {
      "types": "./dist/wrappers/layers.d.ts",
      "require": "./dist/wrappers/layers.cjs",
      "import": "./dist/wrappers/layers.js"
    },
    "./geo-layers": {
      "types": "./dist/wrappers/geo-layers.d.ts",
      "require": "./dist/wrappers/geo-layers.cjs",
      "import": "./dist/wrappers/geo-layers.js"
    },
    "./aggregation-layers": {
      "types": "./dist/wrappers/aggregation-layers.d.ts",
      "require": "./dist/wrappers/aggregation-layers.cjs",
      "import": "./dist/wrappers/aggregation-layers.js"
    },
    "./mesh-layers": {
      "types": "./dist/wrappers/mesh-layers.d.ts",
      "require": "./dist/wrappers/mesh-layers.cjs",
      "import": "./dist/wrappers/mesh-layers.js"
    },
    "./widgets": {
      "types": "./dist/wrappers/widgets.d.ts",
      "require": "./dist/wrappers/widgets.cjs",
      "import": "./dist/wrappers/widgets.js"
    },
    "./reconciler": {
      "types": "./dist/reconciler/index.d.ts",
      "require": "./dist/reconciler/index.cjs",
      "import": "./dist/reconciler/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "yarn test-types && vitest run --config vite.config.js",
    "test-types": "tsc --ignoreConfig --noEmit --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 --skipLibCheck src/**/*.test-d.ts src/**/*.test-d.tsx",
    "test-watch": "vitest --config vite.config.js"
  },
  "dependencies": {
    "client-only": "^0.0.1",
    "its-fine": "^2.0.0",
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "@deck.gl/aggregation-layers": "10.0.0-alpha.1",
    "@deck.gl/core": "10.0.0-alpha.1",
    "@deck.gl/geo-layers": "10.0.0-alpha.1",
    "@deck.gl/layers": "10.0.0-alpha.1",
    "@deck.gl/mapbox": "10.0.0-alpha.1",
    "@deck.gl/maplibre": "10.0.0-alpha.1",
    "@deck.gl/mesh-layers": "10.0.0-alpha.1",
    "@deck.gl/widgets": "10.0.0-alpha.1",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@deck.gl/aggregation-layers": {
      "optional": true
    },
    "@deck.gl/geo-layers": {
      "optional": true
    },
    "@deck.gl/layers": {
      "optional": true
    },
    "@deck.gl/mapbox": {
      "optional": true
    },
    "@deck.gl/maplibre": {
      "optional": true
    },
    "@deck.gl/mesh-layers": {
      "optional": true
    },
    "@deck.gl/widgets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "10.0.0-alpha.1",
    "@deck.gl/core": "10.0.0-alpha.1",
    "@deck.gl/extensions": "10.0.0-alpha.1",
    "@deck.gl/geo-layers": "10.0.0-alpha.1",
    "@deck.gl/layers": "10.0.0-alpha.1",
    "@deck.gl/mapbox": "10.0.0-alpha.1",
    "@deck.gl/maplibre": "10.0.0-alpha.1",
    "@deck.gl/mesh-layers": "10.0.0-alpha.1",
    "@deck.gl/widgets": "10.0.0-alpha.1",
    "@loaders.gl/core": "5.0.0-beta.8",
    "@luma.gl/core": "10.0.0-alpha.14",
    "@luma.gl/engine": "10.0.0-alpha.14",
    "@luma.gl/shaders": "10.0.0-alpha.14",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/react-reconciler": "0.33.0",
    "esbuild": "^0.28.1",
    "fast-check": "^4.0.0",
    "jsdom": "^26.0.0",
    "mapbox-gl": "^3.8.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "6.0.3",
    "vitest": "^4.0.18"
  }
}
