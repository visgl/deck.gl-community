{
  "name": "deck.gl-community",
  "license": "MIT",
  "private": true,
  "keywords": [
    "webgl",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community.git"
  },
  "type": "module",
  "workspaces": [
    "modules/*",
    "dev/*",
    "modules/timeline-layers/examples/*",
    "examples/**"
  ],
  "scripts": {
    "bootstrap": "yarn && ocular-bootstrap",
    "build": "ocular-clean && ocular-build && npx lerna run build",
    "build-bundles": "node ./scripts/build-bundles.mjs",
    "lint": "ocular-lint",
    "lint-pre-commit": "yarn lint",
    "lint-fix": "ocular-lint fix",
    "playwright:install": "playwright install chromium",
    "publish-beta": "ocular-publish version-only-beta",
    "publish-prod": "ocular-publish version-only-prod",
    "test": "ocular-test node",
    "test-node": "ocular-test node",
    "test-types": "tsc -p modules/editable-layers/test/types/tsconfig.json && tsc -p modules/layers/test/types/tsconfig.json && tsc -p modules/panels/test/types/tsconfig.json",
    "test-ci": "ocular-test node --coverage",
    "test-browser": "ocular-test browser",
    "test-headless": "ocular-test headless",
    "conformance-report": "node dev/basemap-conformance/scripts/score.ts",
    "metrics": "ocular-metrics",
    "update-release-branch": "scripts/update-release-branch.sh",
    "test:panels-fullscreen": "node modules/panels/test/full-screen/run-browser.mjs"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "10.0.0-alpha.1",
    "@deck.gl/core": "10.0.0-alpha.1",
    "@deck.gl/layers": "10.0.0-alpha.1",
    "@deck.gl/mapbox": "10.0.0-alpha.1",
    "@deck.gl/maplibre": "10.0.0-alpha.1",
    "@deck.gl/mesh-layers": "10.0.0-alpha.1",
    "@floating-ui/dom": "^1.7.5",
    "@loaders.gl/core": "5.0.0-beta.8",
    "@loaders.gl/images": "5.0.0-beta.8",
    "@luma.gl/core": "10.0.0-alpha.14",
    "@luma.gl/engine": "10.0.0-alpha.14",
    "@luma.gl/shaders": "10.0.0-alpha.14",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bin-pack": "^1.0.3",
    "@types/pngjs": "^6.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vis.gl/dev-tools": "2.0.0-alpha.6",
    "@vis.gl/ts-plugins": "2.0.0-alpha.6",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.17.1",
    "apache-arrow": "^17.0.0",
    "bin-pack": "^1.0.2",
    "playwright": "^1.58.0",
    "pngjs": "^7.0.0",
    "pre-commit": "^1.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "resolutions": {
    "apache-arrow": "17.0.0",
    "typescript": "6.0.3",
    "@loaders.gl/tiles-3d": "5.0.0-beta.8",
    "@loaders.gl/tables": "5.0.0-beta.8",
    "@loaders.gl/compression": "5.0.0-beta.8",
    "@loaders.gl/core": "5.0.0-beta.8",
    "@loaders.gl/crypto": "5.0.0-beta.8",
    "@loaders.gl/scene": "5.0.0-beta.8",
    "@loaders.gl/geospatial": "5.0.0-beta.8",
    "@loaders.gl/images": "5.0.0-beta.8",
    "@loaders.gl/pointclouds": "5.0.0-beta.8",
    "@loaders.gl/raster": "5.0.0-beta.8",
    "@loaders.gl/tiles": "5.0.0-beta.8",
    "@loaders.gl/ogc": "5.0.0-beta.8",
    "@luma.gl/core": "10.0.0-alpha.14",
    "@luma.gl/engine": "10.0.0-alpha.14",
    "@luma.gl/shaders": "10.0.0-alpha.14",
    "fast-xml-parser": "5.5.3",
    "fast-uri": "3.1.7",
    "mjolnir.js": "3.1.1",
    "sigstore@npm:^4.0.0": "patch:sigstore@npm%3A4.1.1#~/.yarn/patches/sigstore-npm-4.1.1-9ab7be1c91.patch"
  },
  "packageExtensions": {
    "deck.gl@*": {
      "peerDependenciesMeta": {
        "@arcgis/core": {
          "optional": true
        }
      }
    },
    "zod-to-json-schema@*": {
      "peerDependencies": {
        "zod": "^4.0.0"
      }
    }
  },
  "pre-commit": [
    "lint-pre-commit",
    "test"
  ],
  "packageManager": "yarn@4.18.0"
}
