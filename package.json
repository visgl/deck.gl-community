{
  "name": "deck.gl-community",
  "license": "MIT",
  "private": true,
  "keywords": [
    "webgl",
    "visualization"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/deck.gl-community.git"
  },
  "type": "module",
  "workspaces": [
    "modules/*",
    "dev/*",
    "modules/timeline-layers/examples/*",
    "examples/**"
  ],
  "scripts": {
    "bootstrap": "yarn && ocular-bootstrap",
    "build": "ocular-clean && ocular-build && npx lerna run build",
    "build-bundles": "node ./scripts/build-bundles.mjs",
    "lint": "ocular-lint",
    "lint-pre-commit": "yarn lint",
    "lint-fix": "ocular-lint fix",
    "playwright:install": "playwright install chromium",
    "publish-beta": "ocular-publish version-only-beta",
    "publish-prod": "ocular-publish version-only-prod",
    "test": "ocular-test node",
    "test-node": "ocular-test node",
    "test-ci": "ocular-test node --coverage",
    "test-browser": "ocular-test browser",
    "test-headless": "ocular-test headless",
    "metrics": "ocular-metrics",
    "update-release-branch": "scripts/update-release-branch.sh"
  },
  "devDependencies": {
    "@deck.gl/aggregation-layers": "~9.4.0-alpha.2",
    "@deck.gl/core": "~9.4.0-alpha.2",
    "@deck.gl/layers": "~9.4.0-alpha.2",
    "@deck.gl/mapbox": "~9.4.0-alpha.2",
    "@deck.gl/mesh-layers": "~9.4.0-alpha.2",
    "@floating-ui/dom": "^1.7.5",
    "@loaders.gl/core": "^4.4.1",
    "@loaders.gl/textures": "^4.4.1",
    "@luma.gl/constants": "~9.4.0-alpha.1",
    "@luma.gl/core": "~9.4.0-alpha.1",
    "@luma.gl/engine": "~9.4.0-alpha.1",
    "@luma.gl/shadertools": "~9.4.0-alpha.1",
    "@luma.gl/webgl": "~9.4.0-alpha.1",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bin-pack": "^1.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vis.gl/dev-tools": "2.0.0-alpha.6",
    "@vis.gl/ts-plugins": "2.0.0-alpha.6",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "apache-arrow": "^17.0.0",
    "bin-pack": "^1.0.2",
    "datauri": "^4.1.0",
    "ndarray": "^1.0.19",
    "ndarray-pixels": "^3.1.0",
    "playwright": "^1.58.0",
    "pre-commit": "^1.2.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "6.0.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "resolutions": {
    "typescript": "6.0.3",
    "@loaders.gl/3d-tiles": "4.4.1",
    "@loaders.gl/compression": "4.4.1",
    "@loaders.gl/core": "4.4.1",
    "@loaders.gl/crypto": "4.4.1",
    "@loaders.gl/csv": "4.4.1",
    "@loaders.gl/draco": "4.4.1",
    "@loaders.gl/geoarrow": "4.4.1",
    "@loaders.gl/gis": "4.4.1",
    "@loaders.gl/gltf": "4.4.1",
    "@loaders.gl/i3s": "4.4.1",
    "@loaders.gl/images": "4.4.1",
    "@loaders.gl/json": "4.4.1",
    "@loaders.gl/las": "4.4.1",
    "@loaders.gl/loader-utils": "4.4.1",
    "@loaders.gl/math": "4.4.1",
    "@loaders.gl/mvt": "4.4.1",
    "@loaders.gl/obj": "4.4.1",
    "@loaders.gl/ply": "4.4.1",
    "@loaders.gl/schema": "4.4.1",
    "@loaders.gl/schema-utils": "4.4.1",
    "@loaders.gl/terrain": "4.4.1",
    "@loaders.gl/textures": "4.4.1",
    "@loaders.gl/tiles": "4.4.1",
    "@loaders.gl/wkt": "4.4.1",
    "@loaders.gl/wms": "4.4.1",
    "@loaders.gl/worker-utils": "4.4.1",
    "@loaders.gl/xml": "4.4.1",
    "@loaders.gl/zip": "4.4.1",
    "@luma.gl/constants": "~9.4.0-alpha.1",
    "@luma.gl/core": "~9.4.0-alpha.1",
    "@luma.gl/engine": "~9.4.0-alpha.1",
    "@luma.gl/shadertools": "~9.4.0-alpha.1",
    "@luma.gl/webgl": "~9.4.0-alpha.1",
    "@luma.gl/webgpu": "~9.4.0-alpha.1",
    "fast-xml-parser": "5.5.3",
    "mjolnir.js": "3.1.0-beta.3"
  },
  "packageExtensions": {
    "deck.gl@*": {
      "peerDependenciesMeta": {
        "@arcgis/core": {
          "optional": true
        }
      }
    },
    "@deck.gl/*@*": {
      "peerDependencies": {
        "@luma.gl/constants": ">=9.4.0-alpha.1",
        "@luma.gl/core": ">=9.4.0-alpha.1",
        "@luma.gl/engine": ">=9.4.0-alpha.1",
        "@luma.gl/shadertools": ">=9.4.0-alpha.1",
        "@luma.gl/webgl": ">=9.4.0-alpha.1",
        "@luma.gl/webgpu": ">=9.4.0-alpha.1"
      }
    },
    "zod-to-json-schema@*": {
      "peerDependencies": {
        "zod": "^4.0.0"
      }
    }
  },
  "pre-commit": [
    "lint-pre-commit",
    "test"
  ],
  "packageManager": "yarn@4.17.1+sha512.ccbfabf7d7b6b32075088be9386fb9a2e00bb6887ef07fa56effabc890a56d53da1ccc4128d62db245fcbd3961b236d75335bdf7d5320ed6eafb7588b7ad4697"
}
